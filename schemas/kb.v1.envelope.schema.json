{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/matheus3301/kb/blob/main/schemas/kb.v1.envelope.schema.json",
  "title": "kb.v1 result envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ok", "warnings", "meta"],
  "properties": {
    "schema_version": {"const": "kb.v1"},
    "ok": {"type": "boolean"},
    "data": {},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string"},
        "retryable": {"type": "boolean"},
        "details": {}
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "layer"],
        "properties": {
          "path": {"type": "string"},
          "code": {"type": "string"},
          "message": {"type": "string"},
          "layer": {"type": "string"},
          "line": {"type": "integer", "minimum": 1}
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "generation", "index_stale"],
      "properties": {
        "root": {"type": "string"},
        "generation": {"type": "string"},
        "index_stale": {"type": "boolean"}
      }
    }
  },
  "oneOf": [
    {"properties": {"ok": {"const": true}}, "required": ["data"], "not": {"required": ["error"]}},
    {"properties": {"ok": {"const": false}}, "required": ["error"], "not": {"required": ["data"]}}
  ]
}
