---
import CopyBlock from './CopyBlock.astro';
const install = 'brew install matheus3301/tap/kb\nkb setup';
const guideRef = '6f77595b0667d2cea7c23f177663f60f189a5691';
const guideURL = `https://github.com/matheus3301/kb/raw/${guideRef}/docs/agent-install.md`;
const guideHref = `https://github.com/matheus3301/kb/blob/${guideRef}/docs/agent-install.md`;
const prompt = `Install KB: ${guideURL}`;
---
<section id="get-started" class="install-section section" aria-labelledby="install-title">
  <div class="section-intro">
    <h2 id="install-title">A small setup.<br />A lasting reference.</h2>
    <p>Install the CLI. Run setup.<br class="desktop-break" /> Choose your agents and where memory applies.</p>
    <a class="text-link" href="https://github.com/matheus3301/kb/blob/main/docs/installation.md">All installation methods <span aria-hidden="true">↗</span></a>
  </div>
  <div class="install-content" data-install-tabs>
    <div class="install-tabs" aria-label="Choose your setup">
      <button type="button" id="tab-you" data-tab="you">For You</button>
      <button type="button" id="tab-agent" data-tab="agent">For Your Agent</button>
    </div>
    <div id="panel-you" class="install-panel" data-panel="you" aria-labelledby="tab-you">
      <p class="panel-intro">On macOS or Linux with Homebrew, the setup flow starts with two commands:</p>
      <CopyBlock id="install-commands" label="Install and set up KB" text={install} />
      <p class="setup-note">Already installed? Run <code>brew update</code> and <code>brew upgrade matheus3301/tap/kb</code>. Setup requires v1.1.0 or later; verify with <code>kb version --json</code> and <code>kb setup --help</code>.</p>
      <p class="setup-note">Choose this project or all your projects, select agents, reuse or create a base, and turn learning on or off. Setup previews its changes. No Node or manual configuration copies are needed for the bundled CLI skill.</p>
      <p class="setup-note">Select Codex, Claude Code, Pi, OMP, OpenCode and other supported adapters. <strong>Configured is not activated:</strong> restart your agent and verify a real source read. Native compatibility and hooks vary by host.</p>
      <a class="text-link" href={guideHref}>Preview, check or uninstall an integration <span aria-hidden="true">↗</span></a>
    </div>
    <div id="panel-agent" class="install-panel" data-panel="agent" aria-labelledby="tab-agent">
      <p class="panel-intro">Give your agent the installer guide.</p>
      <CopyBlock id="agent-setup-prompt" label="Setup prompt" action="Copy" text={prompt} />
      <p class="setup-note">Your agent checks the installed version, reviews the scope and previews changes before applying them.</p>
      <a class="text-link" href={guideHref}>Read the full installer guide <span aria-hidden="true">↗</span></a>
    </div>
    <noscript><p>Both setup paths are shown. Copy commands or the setup prompt manually.</p></noscript>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-install-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    const list = root.querySelector('.install-tabs');
    list?.setAttribute('role', 'tablist');
    function selectTab(index: number, focus = false) {
      tabs.forEach((tab, current) => {
        const selected = current === index;
        tab.setAttribute('role', 'tab');
        tab.setAttribute('aria-selected', String(selected));
        tab.setAttribute('aria-controls', `panel-${tab.dataset.tab}`);
        tab.tabIndex = selected ? 0 : -1;
        panels[current].setAttribute('role', 'tabpanel');
        panels[current].tabIndex = 0;
        panels[current].hidden = !selected;
      });
      if (focus) tabs[index].focus();
    }
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectTab(index));
      tab.addEventListener('keydown', (event) => {
        let next: number;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        selectTab(next, true);
      });
    });
    selectTab(0);
  });
</script>
